# ── Application ───────────────────────────────────────────────
APP_URL=http://localhost:3000                   # use https://… in production (enables HSTS, secure cookies, CSP upgrade)
SERVER_NAME=events.example.com                  # nginx server_name (Docker/production)
# Temporary product name shown throughout the UI/emails. Change to the final brand name when ready.
BRAND_NAME=Su Yet

# ── Database identities (three separate roles) ────────────────
# runtime app role (DML only), schema owner used only by the migrate job, bootstrap superuser used only for backups.
DATABASE_URL=postgresql://letstech_app:change-me-long-random@localhost:5432/letstech_events
POSTGRES_ADMIN_PASSWORD=change-me-long-random
APP_DB_PASSWORD=change-me-long-random
MIGRATOR_DB_PASSWORD=change-me-long-random

# ── Secrets (generate each with: openssl rand -base64 32) ─────
SESSION_SECRET=
MFA_ENCRYPTION_KEY=        # encrypts TOTP secrets at rest. Losing it forces every MFA user to re-enrol; back it up securely.
INTERNAL_API_SECRET=       # n8n signs requests with this (HMAC)
INTERNAL_API_SECRET_PREVIOUS=   # during rotation only: the old secret, accepted until you remove it
CRON_SECRET=               # optional external cron → POST /api/internal/cron

# ── Security policy ───────────────────────────────────────────
INTERNAL_AUTH_MODE=hmac    # hmac (default in production) | both | bearer
CSP_MODE=enforce           # enforce | report-only (to trial a change) | off
HIBP_ENABLED=1             # breached-password screening via k-anonymity range API (only a hash prefix leaves the server)
ALLOW_HTTP_URLS=           # set to 1 only if you deliberately accept plain-HTTP registration/source links
GOOGLE_WEB_RISK_API_KEY=   # optional URL reputation lookup (respect the provider's terms); empty = "unchecked", never "safe"
ALERT_WEBHOOK_URL=         # optional: receives {"text": "..."} for HIGH/CRITICAL alerts (no sensitive data is sent)

# ── First admin (created as SUPER_ADMIN by the seed script when both are set; MFA enrolment forced at first login) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=            # at least 10 characters; change after first login and remove from .env

# ── Email (SMTP). Empty SMTP_HOST = log emails to the console in development only ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Su Yet <no-reply@events.example.com>"
CONTACT_EMAIL=             # optional: also email contact-form messages here

# ── File storage: local | s3 ──────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=             # public base URL of the bucket/CDN, used for image URLs

# ── Backups (scripts/backup.sh refuses to run without a recipient) ──
BACKUP_AGE_RECIPIENT=      # age public key; keep the PRIVATE key off the server
BACKUP_REMOTE=             # optional rclone remote for off-host copies, e.g. s3backup:letstech
HEALTHCHECK_URL=           # optional dead-man's-switch ping URL, hit after every successful backup
